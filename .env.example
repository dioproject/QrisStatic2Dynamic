# Environment: development / production
APP_ENV=development

# Server bind address
APP_BIND=127.0.0.1:8080

# Base URL publik (digunakan untuk webhook/source metadata)
APP_BASE_URL=http://127.0.0.1:8080

# Lokasi SQLite DB
DATABASE_URL=sqlite://./data/qris.db

# Master API Key (minimal 32 karakter, generate dengan: openssl rand -base64 48)
MASTER_API_KEY=

# Master key sebelumnya untuk rotasi tanpa downtime (opsional)
MASTER_API_KEY_PREVIOUS=

# Kunci enkripsi data (AES-256-GCM, WAJIB 32 byte base64: openssl rand -base64 32)
DATA_ENCRYPTION_KEY=

# Mode strict signed request (HMAC): set false HANYA untuk dev lokal; produksi WAJIB true
REQUIRE_SIGNED_REQUESTS=false

# Stateless publik tanpa API key (default: false, sangat tidak disarankan true di produksi)
ALLOW_PUBLIC_STATELESS=false

# Toleransi clock skew tanda tangan (detik)
SIGNATURE_MAX_SKEW_SECONDS=300

# Rate limits
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_BURST=60
RATE_LIMIT_IMAGE_PER_MINUTE=20

# Ukuran body limit
MAX_JSON_BYTES=262144
MAX_IMAGE_BYTES=2097152
MAX_IMAGE_PIXELS=4194304
MAX_PAYLOAD_BYTES=4096

# Transaksi & sweeper
DEFAULT_TTL_SECONDS=900
SWEEPER_INTERVAL_SECONDS=30
SWEEPER_GRACE_SECONDS=300

# Outbound webhook callback
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=6

# Keamanan jaringan & CORS
CORS_ALLOWED_ORIGINS=
TRUST_PROXY=false
ALLOW_INSECURE_CALLBACKS=false

# Logging tracing filter (misal: info, qris_api=debug)
RUST_LOG=info
